                     </loca:Street>
                  </loca:street>
                  <loca:orientationNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12</loca:orientationNumber>
                  <loca:postCode>
                     <loca:PostCode>
                        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">81102</skos:notation>
                     </loca:PostCode>
                  </loca:postCode>
                  <loca:lau2>
                     <loca:LAU2 rdf:about="https://data.gov.sk/def/lau2/SK0101528595">
                        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SK0101528595</skos:notation>
                        <skos:inScheme rdf:resource="https://data.gov.sk/set/codelist/CL000025"/>
                        <skos:prefLabel xml:lang="sk">Bratislava - mestská časť Staré Mesto</skos:prefLabel>
