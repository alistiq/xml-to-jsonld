      </adms:identifier>
      <pper:givenName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">John</pper:givenName>
      <pper:familyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sample</pper:familyName>
      <pper:dateOfBirth rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1990-05-12</pper:dateOfBirth>
      <pper:permanentResidence>
         <pper:PermanentResidence>
            <loca:physicalAddress>
               <loca:PhysicalAddress>
